{
  "schema_version": 1,
  "canonical_missing_token": "na",
  "definition_version": "sample-statistics-5",
  "inference": {
    "metrics": ["dna_ng_per_ml_plasma"],
    "visits": ["diag", "d4", "d8", "d15", "tp1", "tp2"],
    "control_visits": ["diag", "tp1"],
    "alternative": "two-sided",
    "repeat_summary": "median",
    "pooled_analysis": "combine_cohorts_and_controls_with_cohort_qualified_participants",
    "correction": "holm",
    "zero_method": "wilcox",
    "minimum_group_n": 2,
    "minimum_paired_n": 2,
    "resamples": 999999,
    "batch": 256,
    "seed": 42
