  "unassigned_template_fields": ["row", "timepoint", "specimen_type", "tube", "extraction_method", "sampling_plan", "extraction_status"],
  "pooled_display": "combined_box_per_visit_with_cohort_points",
  "plot_jitter_seed": 42,
  "extraction_basis": "dna_id",
  "receipt_rule": "Received, marked missing or unassessed. Literal na marks missingness; a separate overdue flag requires more than 72 hours with applicable CIRCALL timing. Only assessed timing contributes receipt percentages.",
  "inventory_views": ["overall", "specimen_visit"],
  "measurement_views": ["visit"],
  "timezone": "Europe/Paris",
  "grace_hours": 72,
  "deadline_visits": ["diag", "d4", "d8", "d15", "tp1"],
  "pooled_visits": ["diag", "tp1", "tp2"],
  "visits": ["diag", "d4", "d8", "d15", "tp0,5", "tp1", "tp1,5", "tp2", "tp3", "maintenance start", "maintenance end", "3y post-rc", "après inotuzumab", "rc autre", "relapse"],
  "specimens": ["plasma", "blood pellet", "CSF", "bone marrow"],
  "missing_tokens": ["", "na", "n/a", "none", "nan", "-", "sk"],
  "unknown_tokens": ["?"],
  "manual_missed_token": "na",
  "centers": {"001": "RDB", "002": "TRS"},
  "retrospective_center": "RDB",
  "metrics": {
    "extraction_input_volume_ml": {"unit": "mL available specimen", "specimens": ["plasma", "CSF"], "sum": true, "pool": ["plasma", "CSF"], "plot_grouping": "overall"},
    "elution_volume_ul": {"unit": "µL", "specimens": ["plasma", "blood pellet", "CSF", "bone marrow"], "sum": true, "pool": [], "exclude_cohorts": ["retrospective"], "plot_grouping": "overall"},
    "dna_concentration_ng_per_ul": {"plot_scale": "log", "unit": "ng/µL", "specimens": ["plasma", "blood pellet", "CSF", "bone marrow"], "sum": false, "pool": ["plasma"]},
    "dna_total_ng": {"plot_scale": "log", "unit": "ng", "specimens": ["plasma", "blood pellet", "CSF", "bone marrow"], "sum": true, "pool": ["plasma"]},
    "dna_ng_per_ml_plasma": {"plot_scale": "log", "unit": "ng/mL recorded available plasma", "specimens": ["plasma"], "sum": false, "pool": ["plasma"], "pooled_plot_visits": "all", "plot_visits": ["diag", "d4", "d8", "d15", "tp1", "tp2"], "reference_control_cohorts": ["circall", "retrospective"], "reference_control_visit": "control", "plot_visit_labels": {"control": "Controls", "diag": "Diagnosis", "d4": "D4", "d8": "D8", "d15": "D15", "tp1": "MRD1 (D29)", "tp2": "MRD2 (D71)"}, "plot_style": "grant", "plot_jitter_seed": 42},
    "cfdna_fraction": {"unit": "fraction", "specimens": ["plasma", "CSF"], "sum": false, "pool": [], "plot_grouping": "overall"},
    "cfdna_concentration_ng_per_ul": {"plot_scale": "log", "unit": "ng/µL", "specimens": ["plasma", "CSF"], "sum": false, "pool": ["plasma"]},
    "cfdna_total_ng": {"plot_scale": "log", "description": "Total amount of cfDNA in the extract", "unit": "ng", "specimens": ["plasma", "CSF"], "sum": true, "pool": ["plasma"]},
    "cfdna_ng_per_ml_plasma": {"plot_scale": "log", "unit": "ng/mL recorded available plasma", "specimens": ["plasma"], "sum": false, "pool": ["plasma"]},
    "cfdna_avg_size_bp": {"unit": "bp", "specimens": ["plasma", "CSF"], "sum": false, "pool": ["plasma", "CSF"], "plot_grouping": "overall"}
  }
}
