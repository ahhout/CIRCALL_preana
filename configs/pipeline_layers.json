{
  "schema_version": 2,
  "sources": {
    "inventory": "../input/deidentified_20261116_ready/inventory.xlsx",
    "circall": "../input/deidentified_20261116_ready/circall.xlsx",
    "donors": "../input/deidentified_20261116_ready/donors.xlsx",
    "blood-counts": "../input/deidentified_20261116_ready/blood-counts.xlsx",
    "retrospective-blasts": "../input/deidentified_20261116_ready/retrospective-blasts.xlsx"
  },
  "defaults": {
    "cohort": "all",
    "include-controls": true,
    "rules": "definitions/data_integrity.json",
    "pdf-output": false
  },
  "layers": {
    "data_integrity": {
      "options": {}
    },
    "sample_statistics": {
      "options": {
        "definitions": "definitions/sample_statistics.json"
      }
    },
    "advanced_analysis": {
      "options": {
        "definitions": "definitions/advanced_analysis.json",
        "predictors": [
          "requested"
        ],
        "retrospective-wbc-unit": "x10^9/L",
        "spearman-sensitivity": true,
        "sample-selection-seed": 123,
        "pool-cohorts": true,
        "comparison-switches": {
          "circall": {
            "dna_total_ng": {
              "tumor_fraction_percent": true,
              "peripheral_blast_percent": true,
              "gb_per_l": true,
              "corticoide_pre_tt": true,
              "sampling_time": true,
              "genetic_subtype": true
            },
            "dna_ng_per_ml_plasma": {
              "tumor_fraction_percent": true,
              "peripheral_blast_percent": true,
              "gb_per_l": true,
              "corticoide_pre_tt": true,
              "sampling_time": true,
              "elution_volume_ul": true,
              "genetic_subtype": true
            },
            "cfdna_total_ng": {
              "tumor_fraction_percent": true,
              "peripheral_blast_percent": true,
              "gb_per_l": true,
              "corticoide_pre_tt": true,
              "sampling_time": true,
              "elution_volume_ul": true,
              "genetic_subtype": true
            },
            "cfdna_ng_per_ml_plasma": {
              "tumor_fraction_percent": true,
              "peripheral_blast_percent": true,
              "gb_per_l": true,
              "corticoide_pre_tt": true,
              "sampling_time": true,
              "elution_volume_ul": true,
              "genetic_subtype": true
            },
            "cfdna_fraction": {
              "elution_volume_ul": true,
              "extraction_input_volume_ml": true,
              "sampling_time": true,
              "dna_concentration_ng_per_ul": true
            }
          },
          "retrospective": {
            "dna_total_ng": {
              "genetic_subtype": true,
              "sex": true,
              "age_diag": true,
              "gb_per_l": true,
              "Hb_g_per_dL": true,
              "platelets_10e9_per_L": true,
              "peripheral_blast_percent": true
            },
            "dna_ng_per_ml_plasma": {
              "genetic_subtype": true,
              "sex": true,
              "age_diag": true,
              "gb_per_l": true,
              "Hb_g_per_dL": true,
              "platelets_10e9_per_L": true,
              "peripheral_blast_percent": true
            },
            "cfdna_total_ng": {
              "genetic_subtype": true,
              "sex": true,
              "age_diag": true,
              "gb_per_l": true,
              "Hb_g_per_dL": true,
              "platelets_10e9_per_L": true,
              "peripheral_blast_percent": true
            },
            "cfdna_ng_per_ml_plasma": {
              "genetic_subtype": true,
              "sex": true,
              "age_diag": true,
              "gb_per_l": true,
              "Hb_g_per_dL": true,
              "platelets_10e9_per_L": true,
              "peripheral_blast_percent": true
            },
            "cfdna_fraction": {
              "extraction_input_volume_ml": true,
              "dna_concentration_ng_per_ul": true
            }
          }
        }
      }
    },
    "disease_modeling": {
      "options": {
        "analysis": "all",
        "pool-mrd": true,
        "definitions": "definitions/disease_modeling.json",
        "blood-count-unit": "x10^9/L",
        "retrospective-blast-unit": "x10^9/L",
        "baseline-day-max": 1,
        "baseline-selection": "latest",
        "overlay-max-day": 8,
        "kinetics-y-scale": "log",
        "mrd-unknown-level": 1e-06,
        "mrd-negative-level": 1e-08,
        "mrd-positive-nq-level": 1e-06,
        "retrospective-mrd-duplicate-policy": "worst",
        "jitter-seed": 42
      }
    }
  }
}
